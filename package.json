{
  "name": "autoapply",
  "version": "0.1.0",
  "description": "Chrome extension that fills job application forms from your profile.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "npm run build && cd dist && zip -r ../autoapply.zip ."
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
